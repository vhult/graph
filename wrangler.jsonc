// Cloudflare Workers Builds: serves the static docs build with the Storybook under /storybook/, no Worker script.
// Build command `npm run storybook:build`, deploy command `npx wrangler deploy`.
// Response headers (COOP/COEP on /storybook/, caching) come from apps/docs/public/_headers.
{
  "name": "vhult-graph",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  "routes": [
    { "pattern": "graph.vhult.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./apps/docs/dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "dev": {
      "name": "dev-graph",
      "routes": [
        { "pattern": "dev.graph.vhult.com", "custom_domain": true }
      ],
      "assets": {
        "directory": "./apps/docs/dist",
        "not_found_handling": "single-page-application"
      }
    }
  }
}
